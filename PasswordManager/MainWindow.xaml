<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="PasswordManager" Height="600" Width="950"
        Icon="icon.ico"
        MinHeight="500" MinWidth="700">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1"
                CornerRadius="8" Padding="20" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Add New Password" FontSize="18" FontWeight="SemiBold" 
                          Foreground="#495057" Margin="0,0,0,20"/>

                <Label Content="Website:" FontWeight="Medium" Margin="0,0,0,5"/>
                <TextBox Name="WebsiteTextBox" Height="35" Padding="10,8" 
                        BorderBrush="#CED4DA" BorderThickness="1" 
                        FontSize="14" Margin="0,0,0,15"/>

                <Label Content="Username:" FontWeight="Medium" Margin="0,0,0,5"/>
                <TextBox Name="UsernameTextBox" Height="35" Padding="10,8" 
                        BorderBrush="#CED4DA" BorderThickness="1" 
                        FontSize="14" Margin="0,0,0,15"/>

                <Label Content="Password:" FontWeight="Medium" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Name="PasswordTextBox" Height="35" Padding="10,8" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontSize="14" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Name="GenerateButton" Content="Generate" 
                           Height="35" Width="80" Background="#007BFF" Foreground="White" 
                           BorderThickness="0" FontWeight="Medium"
                           Click="GenerateButton_Click"/>
                </Grid>

                <Button Name="AddButton" Content="Add Password" Height="40" 
                       Background="#28A745" Foreground="White" BorderThickness="0" 
                       FontSize="14" FontWeight="Medium" 
                       Click="AddButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                Background="White" BorderBrush="#E9ECEF" BorderThickness="1" 
                CornerRadius="8" Padding="20" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Saved Passwords" FontSize="18" FontWeight="SemiBold" 
                          Foreground="#495057" Margin="0,0,0,20"/>

                <ListView Grid.Row="1" Name="PasswordsListView" 
                         BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Website" DisplayMemberBinding="{Binding Website}" Width="130">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="130">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Actions" Width="200">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Button Content="View" ToolTip="View Password" Click="ViewPassword_Click"
                                                    Width="100" Height="25" Background="#6C757D"
                                                    Foreground="White" BorderThickness="0"
                                                    FontSize="12" Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#5A6268"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="📋" ToolTip="Copy Password to Clipboard" Click="CopyPassword_Click" 
                                               Width="30" Height="28" Background="#17A2B8" 
                                               Foreground="White" BorderThickness="0" 
                                               FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F3F4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <Button Grid.Row="2" Name="DeleteButton" Content="Delete Selected" 
                       HorizontalAlignment="Right" Width="130" Height="35" 
                       Background="#DC3545" Foreground="White" BorderThickness="0" 
                       FontWeight="Medium" Margin="0,15,0,0"
                       Click="DeleteButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>