<Window x:Class="PasswordManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Enter Master Password" Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="icon.ico"
        Background="#F8F9FA">

    <Border Background="White" CornerRadius="12" Margin="20" 
            BorderBrush="#E9ECEF" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBlock Text="🔐" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Password Manager" FontSize="24" FontWeight="SemiBold" 
                          Foreground="#495057" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Text="Login with master password" FontSize="20" 
                          Foreground="#FE2D00" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Master Password -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <Label Content="Master Password:" FontWeight="Medium" 
                       Foreground="#495057" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,10" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontSize="14" KeyDown="PasswordBox_KeyDown"
                             Background="White">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#007BFF"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
            </StackPanel>

            <!-- Confirm Password (for first run) -->
            <StackPanel Grid.Row="2" x:Name="ConfirmPasswordRow" Margin="0,0,0,15">
                <Label Content="Confirm Password:" FontWeight="Medium" 
                       Foreground="#495057" Margin="0,0,0,8"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Padding="12,10" 
                            BorderBrush="#CED4DA" BorderThickness="1" 
                            FontSize="14" KeyDown="PasswordBox_KeyDown"
                             Background="White">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#007BFF"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
            </StackPanel>

            <!-- Info Text -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="6" 
                    Padding="15" Margin="0,0,0,20">
                <TextBlock Text="Your master password encrypts all stored passwords. Choose a strong password and remember it carefully." 
                          TextWrapping="Wrap" FontSize="13" Foreground="#6C757D" 
                          LineHeight="18"/>
            </Border>

            <!-- Spacer -->
            <Grid Grid.Row="4"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" 
                       HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" 
                       Width="90" Height="40" Margin="0,0,15,0"
                       Background="Transparent" Foreground="#6C757D" 
                       BorderBrush="#CED4DA" BorderThickness="1"
                       FontWeight="Medium" FontSize="14"
                       Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                <Setter Property="BorderBrush" Value="#ADB5BD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="LoginButton" Content="Login" 
                       Width="90" Height="40"
                       Background="#007BFF" Foreground="White" 
                       BorderThickness="0" FontWeight="Medium" FontSize="14"
                       Click="LoginButton_Click" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0056B3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>